{
  "name": "andromeda-agent",
  "version": "0.1.0",
  "description": "Agente local do Andromeda: envia só contagens de tokens das IAs de programação, sem prompt nem conteúdo",
  "license": "MIT",
  "author": "Vinícius Veiga Rodrigues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ViniciusVRodrigues/andromeda-agent.git"
  },
  "type": "module",
  "bin": {
    "andromeda-agent": "dist/src/cli.js",
    "andromeda": "dist/src/cli.js"
  },
  "files": [
    "dist/src",
    "README.md",
    "PRIVACY.md",
    "SECURITY.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22.15"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --test --test-reporter=spec \"dist/test/**/*.test.js\"",
    "prepack": "npm run build"
  },
  "dependencies": {
    "@napi-rs/keyring": "2.1.2"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "typescript": "5.9.3"
  }
}
